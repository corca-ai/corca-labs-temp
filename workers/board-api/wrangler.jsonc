{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corca-labs-board-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARDS",
        "class_name": "BoardDurableObject"
      }
    ]
  },
  "exports": {
    "BoardDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

